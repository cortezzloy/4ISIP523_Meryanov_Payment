<Window x:Class="MeryanovPayment.PaymentEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Платёж" Height="700" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Grid Margin="24">
        <StackPanel>
            <TextBlock x:Name="TxtTitle" Text="Добавление платежа" Style="{StaticResource PageTitle}"/>

            <TextBlock Text="Категория" Style="{StaticResource AppText}" Margin="0,8,0,4"/>
            <ComboBox x:Name="CmbCategory" Height="40" DisplayMemberPath="Name" SelectedValuePath="ID"/>

            <TextBlock Text="Название" Style="{StaticResource AppText}" Margin="0,12,0,4"/>
            <TextBox x:Name="TxtName" Style="{StaticResource AppTextBox}"
                     ToolTip="Название платежа"/>

            <TextBlock Text="Дата" Style="{StaticResource AppText}" Margin="0,12,0,4"/>
            <DatePicker x:Name="DpDate" Height="40"/>

            <TextBlock Text="Количество" Style="{StaticResource AppText}" Margin="0,12,0,4"/>
            <TextBox x:Name="TxtNum" Style="{StaticResource AppTextBox}"
                     ToolTip="Целое число > 0"/>

            <TextBlock Text="Цена" Style="{StaticResource AppText}" Margin="0,12,0,4"/>
            <TextBox x:Name="TxtPrice" Style="{StaticResource AppTextBox}"
                     ToolTip="Число ≥ 0"/>

            <TextBlock x:Name="TxtError" Foreground="{StaticResource BrushRed}"
                       FontFamily="{StaticResource AppFont}" FontSize="13"
                       TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Отмена" Style="{StaticResource SecondaryButton}"
                        Width="100" Margin="0,0,8,0" Click="BtnCancel_Click"/>
                <Button Content="Сохранить" Style="{StaticResource PrimaryButton}"
                        Width="120" Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
