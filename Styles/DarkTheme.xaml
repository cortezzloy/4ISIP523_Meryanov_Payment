<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Тёмная тема -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1A1A2E"/>
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#16213E"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#0F3460"/>
    <SolidColorBrush x:Key="FooterBackgroundBrush" Color="#0F3460"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1A1A2E"/>
    <SolidColorBrush x:Key="AlternatingRowBrush" Color="#0F3460"/>

    <SolidColorBrush x:Key="TextBrush" Color="#EAEBED"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9197A3"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#233E76"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#0198AF"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="#233E76"/>

</ResourceDictionary>
