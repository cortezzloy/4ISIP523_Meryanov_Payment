<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Светлая тема -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="FooterBackgroundBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AlternatingRowBrush" Color="#F3F3F3"/>

    <SolidColorBrush x:Key="TextBrush" Color="#233E76"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9197A3"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#EAEBED"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#0198AF"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="#EAEBED"/>

</ResourceDictionary>
