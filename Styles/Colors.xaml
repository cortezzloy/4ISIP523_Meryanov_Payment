<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Основные цвета из руководства по стилю -->
    <Color x:Key="ColorWhite">#FFFFFF</Color>
    <Color x:Key="ColorLightGray">#F3F3F3</Color>
    <Color x:Key="ColorTurquoise">#0198AF</Color>
    <Color x:Key="ColorDarkBlue">#233E76</Color>

    <!-- Дополнительные -->
    <Color x:Key="ColorSoftGray">#EAEBED</Color>
    <Color x:Key="ColorTeal">#4DC6C5</Color>
    <Color x:Key="ColorDeepTeal">#256569</Color>
    <Color x:Key="ColorBlue">#275E9F</Color>
    <Color x:Key="ColorNavy">#006B80</Color>
    <Color x:Key="ColorDarkNavy">#193D57</Color>
    <Color x:Key="ColorGray">#9197A3</Color>
    <Color x:Key="ColorRed">#DD4B42</Color>

    <!-- Кисти -->
    <SolidColorBrush x:Key="BrushWhite" Color="{StaticResource ColorWhite}"/>
    <SolidColorBrush x:Key="BrushLightGray" Color="{StaticResource ColorLightGray}"/>
    <SolidColorBrush x:Key="BrushTurquoise" Color="{StaticResource ColorTurquoise}"/>
    <SolidColorBrush x:Key="BrushDarkBlue" Color="{StaticResource ColorDarkBlue}"/>
    <SolidColorBrush x:Key="BrushSoftGray" Color="{StaticResource ColorSoftGray}"/>
    <SolidColorBrush x:Key="BrushTeal" Color="{StaticResource ColorTeal}"/>
    <SolidColorBrush x:Key="BrushDeepTeal" Color="{StaticResource ColorDeepTeal}"/>
    <SolidColorBrush x:Key="BrushBlue" Color="{StaticResource ColorBlue}"/>
    <SolidColorBrush x:Key="BrushNavy" Color="{StaticResource ColorNavy}"/>
    <SolidColorBrush x:Key="BrushDarkNavy" Color="{StaticResource ColorDarkNavy}"/>
    <SolidColorBrush x:Key="BrushGray" Color="{StaticResource ColorGray}"/>
    <SolidColorBrush x:Key="BrushRed" Color="{StaticResource ColorRed}"/>

</ResourceDictionary>
