<Page x:Class="MeryanovPayment.Pages.ChartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Диаграмма"
      Background="{DynamicResource ContentBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Сумма платежей по категориям" Style="{StaticResource PageTitle}"/>

        <!-- Простая столбчатая диаграмма на Canvas/ItemsControl -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ChartItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Category}" Style="{StaticResource AppText}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Border Grid.Column="1" Height="28" CornerRadius="4"
                                    Background="{DynamicResource AccentBrush}"
                                    HorizontalAlignment="Left"
                                    Width="{Binding BarWidth}"
                                    Margin="8,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding Total, StringFormat=N2}"
                                       Style="{StaticResource AppText}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
