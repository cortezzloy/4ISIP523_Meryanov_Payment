<Page x:Class="MeryanovPayment.Pages.ChangePasswordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Смена пароля"
      Background="{DynamicResource ContentBackgroundBrush}">

    <Grid>
        <Border Width="400" Padding="32" CornerRadius="12"
                Background="{DynamicResource ContentBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Смена пароля" Style="{StaticResource PageTitle}" HorizontalAlignment="Center"/>

                <TextBlock Text="Текущий пароль" Style="{StaticResource AppText}" Margin="0,16,0,4"/>
                <PasswordBox x:Name="TxtOld" Style="{StaticResource AppPasswordBox}"/>

                <TextBlock Text="Новый пароль" Style="{StaticResource AppText}" Margin="0,16,0,4"/>
                <PasswordBox x:Name="TxtNew" Style="{StaticResource AppPasswordBox}"
                             ToolTip="Минимум 6 символов"/>

                <TextBlock Text="Подтверждение" Style="{StaticResource AppText}" Margin="0,16,0,4"/>
                <PasswordBox x:Name="TxtConfirm" Style="{StaticResource AppPasswordBox}"/>

                <TextBlock x:Name="TxtError" Foreground="{StaticResource BrushRed}"
                           FontFamily="{StaticResource AppFont}" FontSize="13"
                           TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

                <Button Content="Сохранить" Style="{StaticResource PrimaryButton}"
                        Margin="0,24,0,0" Click="BtnSave_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
