<Page x:Class="MeryanovPayment.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация"
      Background="{DynamicResource ContentBackgroundBrush}">

    <Grid>
        <Border Width="420" 
                Background="{DynamicResource ContentBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>
                <TextBlock Text="Регистрация" 
                           Style="{StaticResource PageTitle}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>

                <TextBlock Text="ФИО" Style="{StaticResource AppText}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtFIO" Style="{StaticResource AppTextBox}"
                         ToolTip="Фамилия Имя Отчество"/>

                <TextBlock Text="Логин" Style="{StaticResource AppText}" Margin="0,16,0,4"/>
                <TextBox x:Name="TxtLogin" Style="{StaticResource AppTextBox}"
                         ToolTip="Уникальный логин (латиница, цифры)"/>

                <TextBlock Text="Пароль" Style="{StaticResource AppText}" Margin="0,16,0,4"/>
                <PasswordBox x:Name="TxtPassword" Style="{StaticResource AppPasswordBox}"
                             ToolTip="Минимум 6 символов"/>

                <TextBlock Text="Подтверждение пароля" Style="{StaticResource AppText}" Margin="0,16,0,4"/>
                <PasswordBox x:Name="TxtPasswordConfirm" Style="{StaticResource AppPasswordBox}"/>

                <TextBlock x:Name="TxtError" 
                           Foreground="{StaticResource BrushRed}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           Visibility="Collapsed"/>

                <Button Content="Зарегистрироваться" 
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,24,0,0"
                        Click="BtnRegister_Click"/>

                <Button Content="Забыли пароль?" 
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,12,0,0"
                        Click="BtnForgotPassword_Click"/>

                <Button Content="Уже есть аккаунт? Войти" 
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,12,0,0"
                        Click="BtnBackToLogin_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
