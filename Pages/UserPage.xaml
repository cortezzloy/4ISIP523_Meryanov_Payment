<Page x:Class="MeryanovPayment.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мои платежи"
      Background="{DynamicResource ContentBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Фильтры -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" 
                CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtSearch" Style="{StaticResource AppTextBox}"
                         Grid.Column="0" Margin="0,0,8,0"
                         ToolTip="Поиск по названию / категории"
                         TextChanged="Filter_Changed"/>

                <ComboBox x:Name="CmbCategory" Grid.Column="1" Height="40" Margin="0,0,8,0"
                          DisplayMemberPath="Name" SelectedValuePath="ID"
                          ToolTip="Фильтр по категории"
                          SelectionChanged="Filter_Changed"/>

                <DatePicker x:Name="DpFrom" Grid.Column="2" Height="40" Margin="0,0,8,0"
                            ToolTip="Дата с" SelectedDateChanged="Filter_Changed"/>

                <DatePicker x:Name="DpTo" Grid.Column="3" Height="40" Margin="0,0,8,0"
                            ToolTip="Дата по" SelectedDateChanged="Filter_Changed"/>

                <Button Content="Сбросить" Style="{StaticResource SecondaryButton}"
                        Grid.Column="4" Click="BtnReset_Click"/>
            </Grid>
        </Border>

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Сменить пароль" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0" Click="BtnChangePassword_Click"/>
            <Button Content="Выйти" Style="{StaticResource DangerButton}"
                    Click="BtnLogout_Click"/>
        </StackPanel>

        <!-- Таблица -->
        <DataGrid x:Name="DgPayments" Grid.Row="2" Style="{StaticResource AppDataGrid}"
                  MouseDoubleClick="DgPayments_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="150"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Num}" Width="80"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat=N2}" Width="100"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Total, StringFormat=N2}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Итого -->
        <TextBlock x:Name="TxtTotal" Grid.Row="3" Style="{StaticResource AppText}"
                   FontWeight="Bold" FontSize="16" Margin="0,12,0,0"
                   HorizontalAlignment="Right"/>
    </Grid>
</Page>
