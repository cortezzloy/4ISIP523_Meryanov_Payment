<Page x:Class="MeryanovPayment.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Панель администратора"
      Background="{DynamicResource ContentBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Фильтры -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" 
                CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtSearch" Style="{StaticResource AppTextBox}"
                         Grid.Column="0" Margin="0,0,8,0"
                         ToolTip="Поиск по названию / категории / ФИО"
                         TextChanged="Filter_Changed"/>

                <ComboBox x:Name="CmbCategory" Grid.Column="1" Height="40" Margin="0,0,8,0"
                          DisplayMemberPath="Name" SelectedValuePath="ID"
                          SelectionChanged="Filter_Changed"/>

                <DatePicker x:Name="DpFrom" Grid.Column="2" Height="40" Margin="0,0,8,0"
                            SelectedDateChanged="Filter_Changed"/>

                <DatePicker x:Name="DpTo" Grid.Column="3" Height="40" Margin="0,0,8,0"
                            SelectedDateChanged="Filter_Changed"/>

                <Button Content="Сбросить" Style="{StaticResource SecondaryButton}"
                        Grid.Column="4" Click="BtnReset_Click"/>
            </Grid>
        </Border>

        <!-- Кнопки CRUD + экспорт -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <Button Content="+ Добавить" Style="{StaticResource PrimaryButton}"
                    Margin="0,0,8,8" Click="BtnAdd_Click"/>
            <Button Content="Редактировать" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,8" Click="BtnEdit_Click"/>
            <Button Content="Удалить" Style="{StaticResource DangerButton}"
                    Margin="0,0,8,8" Click="BtnDelete_Click"/>
            <Button Content="📊 График" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,8" Click="BtnChart_Click"/>
            <Button Content="Экспорт DOCX" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,8" Click="BtnExportDocx_Click"/>
            <Button Content="Экспорт PDF" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,8" Click="BtnExportPdf_Click"/>
            <Button Content="Экспорт XLSX" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,8" Click="BtnExportXlsx_Click"/>
            <Button Content="Сменить пароль" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,8" Click="BtnChangePassword_Click"/>
            <Button Content="Выйти" Style="{StaticResource DangerButton}"
                    Margin="0,0,0,8" Click="BtnLogout_Click"/>
        </WrapPanel>

        <!-- Таблица -->
        <DataGrid x:Name="DgPayments" Grid.Row="2" Style="{StaticResource AppDataGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="50"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Пользователь" Binding="{Binding UserFIO}" Width="160"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="140"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Num}" Width="70"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat=N2}" Width="90"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Total, StringFormat=N2}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="TxtTotal" Grid.Row="3" Style="{StaticResource AppText}"
                   FontWeight="Bold" FontSize="16" Margin="0,12,0,0"
                   HorizontalAlignment="Right"/>
    </Grid>
</Page>
