<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <connectionStrings>
		<add name="PaymentDb"
     connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=DB_Meryanov_Payment;Integrated Security=True;TrustServerCertificate=True;"
     providerName="System.Data.SqlClient" />
    </connectionStrings>
    <appSettings>
        <!-- Сохранённая тема: Light / Dark -->
        <add key="Theme" value="Light" />
    </appSettings>
</configuration>
